# Set to the computer's LAN IP for phone access; trust the Caddy CA on the phone.
APP_HOST=localhost
PUBLIC_ORIGIN=https://localhost
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Публичный набор корневых сертификатов лежит в infra/ca/ и монтируется в /certificates.
GIGACHAT_CA_FILE=/certificates/russian_trusted_ca_bundle.pem
